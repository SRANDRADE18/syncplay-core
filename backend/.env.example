# String de conexão com o banco de dados PostgreSQL
# Substitua USER, PASSWORD, HOST, PORT, DATABASE pelas suas credenciais
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Porta do servidor
PORT=3000

# Chave secreta para assinatura de tokens JWT
JWT_SECRET="SUPERSAFE_SECRET_KEY"

# Origem permitida no CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"

# Limite estrito de 1 conta por IP no registro (defina como "true" apenas em produção)
ENFORCE_IP_LIMIT="false"

