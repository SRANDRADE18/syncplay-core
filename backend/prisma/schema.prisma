generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String?
  email               String   @unique
  password            String
  avatar              String?
  referral_code       String?  @unique
  premium_until       DateTime?
  registration_ip     String?
  device_fingerprint  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relacionamentos
  referralsMade       ReferralEvent[] @relation("Referrer")
  referralReceived    ReferralEvent?  @relation("ReferredUser")
  rooms               Room[]          @relation("UserRooms")
}

model ReferralEvent {
  id              String   @id @default(uuid())
  referrer_id     String
  referred_id     String   @unique // Um usuário só pode ser indicado uma vez
  createdAt       DateTime @default(now())

  referrer        User     @relation("Referrer", fields: [referrer_id], references: [id])
  referredUser    User     @relation("ReferredUser", fields: [referred_id], references: [id])
}

model Room {
  id        String   @id @default(uuid())
  title     String   @default("Nova Sessão SyncPlay")
  host_id   String
  video_url String
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host      User     @relation("UserRooms", fields: [host_id], references: [id])
}
